# Public, publishable Supabase configuration. These values are safe to expose to
# the browser but must never be replaced with a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Use a restricted direct PostgreSQL connection for the one
# authoritative transaction that spans ledger, idempotency, and audit tables.
# Never expose this value to the browser or prefix it with NEXT_PUBLIC_.
DATABASE_URL=
NOTIFICATION_SCHEDULER_SECRET=
NOTIFICATION_SCHEDULER_ADMIN_USER_ID=
